{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=frontend"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=backend"],
      "port": 3001
    },
    {
      "name": "email-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-l", "4321", "docs/emails"],
      "port": 4321
    }
  ]
}
