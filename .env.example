PORT=3000
DATABASE_URL=
# Max pg pool connections per Node worker. With PM2 cluster (2 workers) and
# Postgres max_connections=100, 25 is a safe default. Bump if you grow the VM.
DB_POOL_MAX=25
JWT_SECRET=
DEEPSEEK_API_KEY=
# DeepSeek V4 model ids. Tiered routing: FLASH (thinking off) for bulk
# map/synthesis passes, PRO (thinking on, high effort) for reasoning-critical
# passes (recomputation, calc grading). Override to flip flash↔pro per tier or
# to point at self-hosted weights. Defaults shown.
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# Optional: override the API base (e.g. self-hosted vLLM). Defaults to public API.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional: label the primary account in logs/Telegram fallback alerts.
# DEEPSEEK_ACCOUNT_NAME=primary

# Optional: additional DeepSeek-compatible accounts (separately billed —
# e.g. an Alibaba Cloud DashScope compatible-mode account) tried in order
# when the primary account fails with a retryable error (401/402/403/408/
# 429/5xx/network — an account-specific or transient failure, not a bad
# request). Numbered 2..5; each needs its own _BASE_URL_N if it's not
# api.deepseek.com. A successful fallback fires a Telegram alert (see
# TELEGRAM_BOT_TOKEN below) so a dying account gets noticed, not just
# silently absorbed until the last one fails too.
# DEEPSEEK_API_KEY_2=
# DEEPSEEK_BASE_URL_2=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEEPSEEK_ACCOUNT_NAME_2=alibaba

# Qwen3 — reached only via explicit providerOverride (cross-provider ensemble
# samples, cross-provider critique), not as an institution-selectable default
# provider yet. Not required for the app to run; if unset, Qwen ensemble
# samples fail and drop silently, degrading to the pre-Qwen ensemble.
# QWEN_API_KEY=
# Defaults to DashScope's INTERNATIONAL compatible-mode endpoint. DashScope
# keys are region-locked to whichever endpoint issued them (401 on the
# other) — switch to the mainland host below if your key needs it.
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DashScope's proprietary hosted tiers (not open-weight — can't be
# self-hosted). Chosen for quality since Qwen is internal-only
# (ensemble/verification) today, not institution-facing. Revisit if Qwen
# ever needs to satisfy RU-residency directly. FLASH stays on the cheaper
# Plus tier (cheap ensemble secondaries just need model-family diversity);
# THINKING steps up to Max for the reasoner path (calc verification), which
# is where the stronger tier actually earns its cost.
# QWEN_MODEL_FLASH=qwen3.7-plus
# QWEN_MODEL_THINKING=qwen3.7-max
NODE_ENV=development

# URL of the frontend app (used by backend to generate email links)
FRONTEND_URL=http://localhost:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:3000

# ── Email ──────────────────────────────────────────────────────────
# Provider priority: Unisender Go (API) → SMTP → console (dev only).
# Sender domain must be VERIFIED (DKIM/SPF) in your provider or mail is rejected.
EMAIL_FROM=noreply@ispum.ru
EMAIL_FROM_NAME=ИСПУМ
# Owner notifications (new signups, purchases). Leave blank to disable.
ADMIN_NOTIFY_EMAIL=

# Preferred: Unisender Go transactional API (leave blank to fall back to SMTP)
UNISENDER_API_KEY=
# Cluster endpoint — our account is on go2. Override only if the account moves.
# UNISENDER_ENDPOINT=https://go2.unisender.ru/ru/transactional/api/v1/email/send.json

# Fallback: classic SMTP (e.g. Mail.ru для бизнеса smtp.mail.ru:465)
# Leave blank in development; emails will be logged to the console instead
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Yandex Cloud — document OCR + object storage
# Leave blank in dev: OCR is skipped, files saved to ./uploads
YANDEX_FOLDER_ID=
YANDEX_VISION_API_KEY=
# Yandex Cloud Search API v2 key. Powers both:
#   • web grounding for the topic generator (services/yandexSearch.ts)
#   • image search for the lecture presentation picker
#     (services/yandexImages.ts → POST /v2/image/search, sync-only)
# Optional — if blank, topic generation falls back to model knowledge only
# and the slide image picker is disabled (diagram cards still render with
# the placeholder).
YANDEX_SEARCH_API_KEY=
YANDEX_STORAGE_BUCKET=gradeassist-uploads
YANDEX_STORAGE_ACCESS_KEY=
YANDEX_STORAGE_SECRET_KEY=
YANDEX_STORAGE_ENDPOINT=https://storage.yandexcloud.net

# Yandex per-unit pricing (₽, converted via services/fxRate.ts) for
# cost-tracking api_usage_log rows (config/planLimits.ts, TODO.md
# Improvement #13). Optional — all six have a built-in default confirmed
# against the real Yandex AI Studio console pricing tables (2026-07-30).
# Only set these to override a rate that's changed since.
# YANDEX_RATE_CHAT_IN_RUB_PER_M=500
# YANDEX_RATE_CHAT_OUT_RUB_PER_M=1200
# YANDEX_RATE_EMBED_RUB_PER_M=10.1
# YANDEX_RATE_VISION_RUB_PER_PAGE=0.1321
# YANDEX_RATE_WEB_SEARCH_RUB_PER_CALL=0.0305
# YANDEX_RATE_IMAGE_SEARCH_RUB_PER_CALL=0.915

# Spend circuit breakers (TODO.md Feature AL) — all disabled by default
# (no-op until set). Set once real traffic volume makes a number
# meaningful; each is a blunt cost backstop, not a plan-tier gate.
#   GLOBAL_DAILY_SPEND_CAP_USD    — whole-platform daily ceiling (globalSpendCap.ts)
#   FEATURE_SPEND_CAP_<FEATURE>_USD             — one feature's daily ceiling, e.g. FEATURE_SPEND_CAP_PRESENTATION_USD
#   FEATURE_SPEND_CAP_<FEATURE>_<VARIANT>_USD   — narrower still, e.g. FEATURE_SPEND_CAP_PRESENTATION_DEEP_USD
#     (checked ON TOP OF the feature-level cap, not instead of it — see services/featureSpendCap.ts)
# GLOBAL_DAILY_SPEND_CAP_USD=
# FEATURE_SPEND_CAP_PRESENTATION_DEEP_USD=

# Monthly infra cost (₽ or $ — services/capacityModel.ts assumes USD),
# for AdminCapacity's investor-mode fixed/variable cost split. Unset by
# default — the page shows an honest "—" rather than a guessed number.
# MONTHLY_INFRA_COST_USD=

# Deploy-only — id of the CDN resource fronting the site. deploy.sh purges the
# no-cache entrypoints (index.html, sw.js, …) here after each frontend upload so
# PWA clients aren't stuck on a stale service worker. Find it: `yc cdn resource list`.
# Optional: if blank, deploy skips the purge (clients update on SW revalidation).
CDN_RESOURCE_ID=

# Deploy-only — Yandex Container Registry id the backend image lives in
# (docs/on-prem-deployment.md §16 Track 1.4). Same registry CI pushes to —
# find it on the registry's detail page in the console. Required for deploy.sh
# to pull the image; not read by the app itself at runtime.
YC_REGISTRY_ID=

# ── Control-plane telemetry (docs/on-prem-deployment.md §16 Track 1.6) ──────
# Every ИСПУМ deployment signs and pushes an aggregate telemetry envelope to
# the control plane every 15 minutes. Phase 1: our own cloud pushes to
# ITSELF over localhost — proves the whole sign→ingest→store path with zero
# on-prem risk before any real remote deployment exists.
# Generate: npx tsx backend/scripts/generateControlPlaneKeypair.ts
# Optional — heartbeats simply don't send while unset (validateConfig warns).
CONTROL_PLANE_PRIVATE_KEY=
# Which deployment THIS backend is. Defaults to migration 113's seeded
# 'ispum-cloud' row — only override for a second, distinct deployment.
# CONTROL_PLANE_DEPLOYMENT_ID=00000000-0000-0000-0000-000000000001
# Where to POST heartbeats. Empty = self (http://127.0.0.1:$PORT) — correct
# for Phase 1. A real remote deployment points this at the actual control
# plane once one exists outside this same process (Phase 3).
# CONTROL_PLANE_URL=

# T-Bank (Tinkoff) acquiring — get a terminal at https://www.tbank.ru/kassa/
TBANK_TERMINAL_KEY=
TBANK_TERMINAL_PASSWORD=

# Yandex Foundation Models (embeddings — RAG flywheel)
# Service account behind the key needs the ai.languageModels.user role.
# Falls back to YANDEX_VISION_API_KEY if unset.
YANDEX_API_KEY=your_yandex_api_key

# ── SAML 2.0 SSO (Service Provider) ────────────────────────────────
# Global SP identity used by every institutional IdP we integrate with.
# Generate the keypair once with:  npx tsx backend/scripts/generateSamlSpKeypair.ts
# Paste both values as single-line PEM strings with \n in place of newlines.
SAML_SP_ENTITY_ID=https://ispum.ru/api/sso/sp
SAML_SP_PRIVATE_KEY=
SAML_SP_CERTIFICATE=

# ── Telegram production-incident alerts ────────────────────────────
# Optional — without these, unknown 500s / DB outages are still logged and
# recorded in production_incidents, just not pushed anywhere. Create a bot via
# @BotFather, get the chat id by messaging the bot then hitting
# https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Nightly database backup (scripts/backupDatabase.ts, npm run backup:db) ──
# A SEPARATE bucket from YANDEX_STORAGE_BUCKET (uploads) — different failure
# domain, and the service account behind these keys should be write-only
# (storage.uploader role, not storage.editor) so a compromised VM can't
# delete backup history. Falls back to YANDEX_STORAGE_ACCESS_KEY/SECRET_KEY if
# unset, but a dedicated write-only account is strongly preferred — see
# docs/support/runbooks/restore-database.md.
BACKUP_STORAGE_BUCKET=
BACKUP_STORAGE_ACCESS_KEY=
BACKUP_STORAGE_SECRET_KEY=
BACKUP_STORAGE_ENDPOINT=https://storage.yandexcloud.net

# ── Fetch programme documents from a pasted URL (services/documentFetch.ts) ──
# When a user pastes a link to a document in their university's web system, the
# server fetches it directly (РПД / practices / описание ОП / учебный план).
# SECURITY: fetching is restricted to a domain allowlist. The PRIMARY source is
# per-institution — an institution admin manages it on the org overview page
# (institutions.document_fetch_domains). This variable is an OPTIONAL global
# supplement (comma- or space-separated) folded into every institution's list —
# useful for a shared portal domain common to many institutions. Leave empty to
# use only each institution's own configured domains. Matching covers subdomains
# (kstu.ru allows www.kstu.ru).
DOCUMENT_FETCH_ALLOWED_DOMAINS=
