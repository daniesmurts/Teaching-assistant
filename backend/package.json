{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=../.env ../node_modules/.bin/tsx watch --ignore '../node_modules/**' --ignore '../frontend/**' src/index.ts",
    "build": "tsc",
    "start": "node --env-file=../.env dist/backend/src/index.js",
    "migrate": "node --env-file=../.env scripts/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration:setup": "../node_modules/.bin/tsx scripts/setup-test-db.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval": "node --env-file=../.env ../node_modules/.bin/tsx scripts/runEval.ts",
    "backfill:embeddings": "node --env-file=../.env ../node_modules/.bin/tsx scripts/backfillEmbeddings.ts",
    "eval:confidence": "node --env-file=../.env ../node_modules/.bin/tsx scripts/runConfidenceEval.ts",
    "test:yandex-images": "node --env-file=../.env ../node_modules/.bin/tsx scripts/testYandexImages.ts",
    "repair:filenames": "node --env-file=../.env ../node_modules/.bin/tsx scripts/repairFilenames.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1059.0",
    "@node-saml/node-saml": "^5.0.0",
    "axios": "^1.17.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "mathjs": "^15.2.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.10",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.2",
    "pg": "^8.12.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.0",
    "dotenv-cli": "^7.4.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.8"
  }
}
